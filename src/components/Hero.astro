---
import ButtonLink from "./ui/ButtonLink.astro";
---

<section
  class="relative min-h-screen flex items-center justify-center text-center overflow-hidden"
>
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <div class="absolute inset-0 bg-[var(--overlay-color)] mix-blend-multiply z-10"></div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-[var(--bg-primary)] via-[var(--overlay-color)]/20 to-transparent z-10"
    >
    </div>
    <img
      src="/puzzle.webp"
      alt="Background"
      class="w-full h-full object-cover object-center lg:object-right"
    />
  </div>

  <!-- Content -->
  <div class="relative z-20 w-full max-w-4xl mx-auto px-6 py-24">
    <div
      class="glass-panel rounded-3xl p-8 md:p-16 flex flex-col items-center justify-center gap-8 md:gap-10"
    >
      <div class="flex flex-col items-center gap-2">
        <h1
          class="text-5xl md:text-7xl lg:text-8xl font-display font-bold text-text-primary tracking-tighter text-glow drop-shadow-2xl"
        >
          exFutura
        </h1>
        <p
          class="text-text-secondary font-mono text-sm md:text-base tracking-widest opacity-80"
        >
          /ɛks fuˈtuːrə/
        </p>
      </div>

      <div class="w-16 h-[1px] bg-accent-red/50"></div>

      <div class="flex flex-col items-center gap-3">
        <h2
          class="text-xl md:text-3xl font-sans font-light text-text-primary/90 tracking-wide"
        >
          Soluciones digitales a medida
        </h2>
        <p
          class="text-text-secondary font-sans text-sm md:text-base max-w-lg leading-relaxed"
        >
          Web <span class="text-accent-red mx-1">•</span> Mobile <span
            class="text-accent-red mx-1">•</span
          > Automatización <span class="text-accent-red mx-1">•</span> Consultoría técnica
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-4 mt-4 w-full sm:w-auto">
        <a
          href="/contact"
          class="px-8 py-4 bg-text-primary text-bg-primary font-sans font-medium rounded-full hover:opacity-90 transition-all duration-300 w-full sm:w-auto hover:scale-105 transform text-center flex items-center justify-center gap-2"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
          Contactanos
        </a>
        <a
          href="/services"
          class="px-8 py-4 bg-transparent text-text-primary border border-text-primary/20 font-sans font-medium rounded-full hover:bg-text-primary/5 transition-all duration-300 w-full sm:w-auto hover:scale-105 transform text-center flex items-center justify-center gap-2"
        >
          Ver servicios
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>
</section>
