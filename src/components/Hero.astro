---
import ButtonLink from "./ui/ButtonLink.astro";
---

<section
  class="bg-[url('/puzzle.webp')] bg-blend-multiply bg-fixed bg-cover lg:bg-center bg-right text-black flex items-center justify-center text-center h-full lg:p-0 p-6"
>
  <div
    class="bg-white/60 backdrop-blur-md max-w-3xl mx-auto lg:p-10 p-4 z-10 border rounded-3xl border-gray-200 shadow-lg shadow-black/50 flex flex-col items-center justify-evenly gap-4"
  >
    <span>
      <h1 class="text-4xl md:text-5xl font-thin font-mono">exFutura</h1>
      <p class="text-md font-serif italic">/ɛks fuˈtuːrə/</p>
    </span>
    <h2 class="lg:text-xl md:text-lg text-base font-sans">
      Soluciones digitales a medida
    </h2>
    <p class="lg:mt-4 mt-2 text-black text-md font-mono">
      Web, Mobile, Hardware, Consultoría técnica
    </p>
    <span class="flex lg:flex-row flex-col lg:gap-4 gap-2">
      <ButtonLink href="/contact" text="Contactanos" />
      <ButtonLink href="/services" text="Ver servicios" />
    </span>
  </div>
</section>
