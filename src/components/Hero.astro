---
import { Image } from "astro:assets";
import puzzleImg from "../assets/puzzle.webp";
import ButtonLink from "./ui/ButtonLink.astro";

const base = import.meta.env.BASE_URL;
const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
---

<section
  class="relative min-h-screen flex items-center justify-center text-center overflow-hidden"
>
  <!-- Background Image with Overlay -->
  <div class="absolute inset-0 z-0">
    <div
      class="absolute inset-0 bg-[var(--overlay-color)] mix-blend-multiply z-10"
    >
    </div>
    <div
      class="absolute inset-0 bg-gradient-to-t from-[var(--bg-primary)] via-[var(--overlay-color)]/20 to-transparent z-10"
    >
    </div>
    <Image
      src={puzzleImg}
      alt="Background"
      class="w-full h-full object-cover object-center lg:object-right"
    />
  </div>

  <!-- Content -->
  <div class="relative z-20 w-full max-w-4xl mx-auto px-6 py-24">
    <div
      class="glass-panel rounded-3xl p-8 md:p-16 flex flex-col items-center justify-center gap-8 md:gap-10"
    >
      <div class="flex flex-col items-center gap-2">
        <h1
          class="text-5xl md:text-7xl lg:text-8xl font-display font-bold text-text-primary tracking-tighter text-glow drop-shadow-2xl animate-fade-in"
        >
          exFutura
        </h1>
        <p
          class="text-text-secondary font-mono text-sm md:text-base tracking-widest opacity-80 animate-fade-in"
        >
          /ɛks fuˈtuːrə/
        </p>
      </div>

      <div class="w-16 h-[1px] bg-accent-red/50"></div>

      <div class="flex flex-col items-center gap-3">
        <h2
          class="text-xl md:text-3xl font-sans font-light text-text-primary/90 tracking-wide min-h-[1.5em]"
          id="typing-text"
        >
          Soluciones digitales a medida
        </h2>
        <p
          class="text-text-secondary font-sans text-sm md:text-base max-w-lg leading-relaxed animate-fade-in"
          id="tagline"
        >
          Web <span class="text-accent-red mx-1">•</span> Mobile <span
            class="text-accent-red mx-1">•</span
          > Automatización <span class="text-accent-red mx-1">•</span> Consultoría
          técnica
        </p>
      </div>

      <div
        class="flex flex-col sm:flex-row gap-4 mt-4 w-full sm:w-auto animate-slide-up"
        id="cta-container"
      >
        <a
          href={`${cleanBase}/contact`}
          class="px-8 py-4 bg-text-primary text-bg-primary font-sans font-medium rounded-full hover:opacity-90 transition-all duration-300 w-full sm:w-auto hover:scale-105 transform text-center flex items-center justify-center gap-2"
          aria-label="Contactar con exFutura para iniciar un proyecto"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-send"
            aria-hidden="true"
            ><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"
            ></path></svg
          >
          Contactanos
        </a>
        <a
          href={`${cleanBase}/services`}
          class="px-8 py-4 bg-transparent text-text-primary border border-text-primary/20 font-sans font-medium rounded-full hover:bg-text-primary/5 transition-all duration-300 w-full sm:w-auto hover:scale-105 transform text-center flex items-center justify-center gap-2"
          aria-label="Ver todos los servicios que ofrecemos"
        >
          Ver servicios
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            class="lucide lucide-arrow-right"
            aria-hidden="true"
            ><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg
          >
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes slide-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes text-glow {
    0%,
    100% {
      text-shadow: 0 0 20px rgba(255, 69, 58, 0.1);
    }
    50% {
      text-shadow: 0 0 40px rgba(255, 69, 58, 0.4);
    }
  }

  .h1-text {
    animation: text-glow 4s ease-in-out infinite;
  }

  .animate-fade-in {
    animation: fade-in 1s ease-out forwards;
    animation-delay: 0.5s;
    opacity: 0;
  }

  .animate-slide-up {
    animation: slide-up 1s ease-out forwards;
    animation-delay: 0.8s;
    opacity: 0;
  }

  h1 {
    animation: text-glow 4s ease-in-out infinite;
  }

  #typing-text::after {
    content: "|";
    animation: blink 1s step-end infinite;
    margin-left: 2px;
    color: var(--accent-red);
  }

  @keyframes blink {
    from,
    to {
      opacity: 1;
    }
    50% {
      opacity: 0;
    }
  }
</style>

<script>
  function initTyping() {
    const textElement = document.getElementById("typing-text");
    if (!textElement) return;

    const prefix = "Soluciones digitales ";
    const suffixes = ["a medida", "para empresas", "para vos"];

    let suffixIndex = 0;
    let charIndex = suffixes[0].length;
    let isDeleting = true;

    function type() {
      const currentSuffix = suffixes[suffixIndex];
      let delay;

      if (isDeleting) {
        charIndex--;
        textElement.textContent =
          prefix + currentSuffix.substring(0, charIndex);
        delay = 50;

        if (charIndex === 0) {
          isDeleting = false;
          suffixIndex = (suffixIndex + 1) % suffixes.length;
          delay = 500;
        }
      } else {
        charIndex++;
        textElement.textContent =
          prefix + suffixes[suffixIndex].substring(0, charIndex);
        delay = 100;

        if (charIndex === suffixes[suffixIndex].length) {
          isDeleting = true;
          delay = 2000;
        }
      }

      setTimeout(type, delay);
    }

    // Start deleting after initial pause
    setTimeout(type, 2000);
  }

  document.addEventListener("astro:page-load", initTyping);
</script>
