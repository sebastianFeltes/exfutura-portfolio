---
// src/components/SectionTitle.astro
const { title, subtitle } = Astro.props;
---
<section class="text-left z-10 flex flex-col gap-2">
  <h2 class="text-3xl md:text-4xl font-bold font-display text-text-primary tracking-tight">{title}</h2>
  {subtitle && <p class="text-accent-red font-mono tracking-widest text-sm uppercase">{subtitle}</p>}
</section>