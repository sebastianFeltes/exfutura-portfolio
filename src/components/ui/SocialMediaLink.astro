---
interface Props {
  href: string;
  icon: string;
  label: string;
}

const { href, icon, label } = Astro.props;
---

<a
  href={href}
  target="_blank"
  class="group flex items-center justify-center gap-3 w-full sm:w-64 px-6 py-4 rounded-xl border border-glass-border bg-glass-bg-light hover:bg-glass-border transition-all duration-300 hover:-translate-y-1"
>
  <img
    src={icon}
    alt={label}
    class="w-6 h-6 transition-transform duration-300 group-hover:scale-110 invert opacity-80 group-hover:opacity-100 theme-icon"
  />
  <span class="font-sans font-medium text-text-secondary group-hover:text-text-primary transition-colors">{label}</span>
</a>

<style>
  [data-theme="light"] .theme-icon {
    filter: none;
  }
</style>