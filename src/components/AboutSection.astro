---
interface Props {
  title?: string;
  delay?: number;
}

const { title, delay = 0 } = Astro.props;
---

<div class="flex flex-col gap-4 glass-panel p-6 sm:p-8 rounded-2xl h-full border border-glass-border">
  <h2 class="text-xl md:text-2xl font-display font-medium text-text-primary">
    {title}
  </h2>
  <p class="text-text-secondary font-sans leading-relaxed text-sm md:text-base">
    <slot />
  </p>
</div>
