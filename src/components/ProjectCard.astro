---
// src/components/ProjectCard.astro
const { title, description, techs, image } = Astro.props;
---
<div class="glass-panel rounded-2xl overflow-hidden flex flex-col h-full border border-glass-border">
  <div class="relative h-48 w-full bg-bg-secondary/50 overflow-hidden">
    <img loading="eager" decoding="async" fetchpriority="high" src={image} alt={title} class="w-full h-full object-cover transition-transform duration-500 hover:scale-110" />
  </div>
  <div class="p-6 flex flex-col gap-2 flex-grow">
    <h3 class="text-xl font-display font-medium text-text-primary">{title}</h3>
    <p class="text-text-secondary text-sm font-sans leading-relaxed line-clamp-2">{description}</p>
    <div class="mt-auto pt-4 flex flex-wrap gap-2">
      {techs.map((tech: string) => (
        <span class="text-[10px] uppercase tracking-wider font-mono px-2 py-1 bg-accent-red-dim border border-accent-red/20 text-accent-red rounded">
          {tech}
        </span>
      ))}
    </div>
  </div>
</div>