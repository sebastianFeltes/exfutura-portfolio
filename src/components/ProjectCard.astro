---
// src/components/ProjectCard.astro
const { title, description, techs, image } = Astro.props;
---
<div class="bg-white shadow-md rounded-md overflow-hidden border border-gray-200">
  <img src={image} alt={title} class="w-full h-48 object-cover" />
  <div class="p-4">
    <h3 class="text-xl font-semibold font-sans">{title}</h3>
    <p class="text-gray-600 text-sm mt-1">{description}</p>
    <p class="mt-2 text-xs text-gray-400 font-mono">{techs.join(' | ')}</p>
  </div>
</div>