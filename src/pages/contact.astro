---
import Layout from "../layouts/Layout.astro";
import SectionTitle from "../components/SectionTitle.astro";
import Button from "../components/ui/Button.astro";
import SocialMediaLink from "../components/ui/SocialMediaLink.astro";

const socialMedia = [
  {
    href: "https://www.instagram.com/exfutura.dev/",
    icon: "/instagram-icon.png",
    label: "Instagram",
  },
  {
    href: "https://wa.link/rxypzc",
    icon: "/whatsapp-icon.png",
    label: "WhatsApp",
  },
];
---

<Layout title="Contacto">
  <section
    id="contacto"
    class="relative min-h-screen pt-24 pb-12 overflow-hidden flex items-center"
  >
    <!-- Background Image with Dark Overlay -->
    <div class="absolute inset-0 z-0 fixed">
      <div class="absolute inset-0 bg-[var(--overlay-color)] mix-blend-multiply z-10"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--bg-primary)] via-transparent to-[var(--bg-primary)]/50 z-10"></div>
      <img
        src="/email.webp"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        alt="Contact background"
        class="w-full h-full object-cover object-center"
      />
    </div>

    <!-- Content -->
    <div class="relative z-10 w-full max-w-6xl mx-auto px-6 flex flex-col gap-12">
      <!-- Header -->
      <div class="text-center pt-8 pb-4">
        <h1 class="text-4xl md:text-5xl font-display font-bold text-text-primary tracking-tight">Contacto</h1>
        <div class="w-12 h-[2px] bg-accent-red/60 mx-auto mt-4 mb-2"></div>
      </div>

      <div class="flex flex-col lg:flex-row gap-8 items-stretch justify-center">
        <!-- Formulario -->
        <div class="w-full lg:w-1/2 glass-panel p-8 md:p-10 rounded-3xl flex flex-col gap-6 border border-glass-border">
          <div class="flex flex-col gap-2">
            <h2 class="text-2xl font-display font-medium text-text-primary">
              Envíanos un mensaje
            </h2>
            <p class="text-text-secondary font-sans text-sm">
              ¡Te responderemos lo antes posible!
            </p>
          </div>

          <!-- Mensaje de error -->
          <div id="error-msg" class="hidden bg-accent-red-dim border border-accent-red/20 text-accent-red px-4 py-3 rounded-lg text-sm font-sans">
            Por favor completá todos los campos correctamente.
          </div>

          <form
            id="contact-form"
            class="flex flex-col gap-5 flex-1"
            action="https://formspree.io/f/mldlrenw"
            method="POST"
          >
            <div class="flex flex-col gap-2">
              <label for="email" class="text-text-secondary text-sm font-medium font-sans">
                Email
              </label>
              <input
                id="email"
                class="w-full bg-glass-bg-light border border-glass-border rounded-xl px-4 py-3 text-text-primary placeholder-text-secondary/50 focus:outline-none focus:ring-2 focus:ring-accent-red/50 focus:border-accent-red/50 transition-all font-sans"
                required
                placeholder="tu-email@ejemplo.com"
                type="email"
                name="email"
              />
            </div>
            
            <div class="flex flex-col gap-2 flex-1">
              <label for="message" class="text-text-secondary text-sm font-medium font-sans">
                Mensaje
              </label>
              <textarea
                id="message"
                class="w-full h-full min-h-[150px] bg-glass-bg-light border border-glass-border rounded-xl px-4 py-3 text-text-primary placeholder-text-secondary/50 focus:outline-none focus:ring-2 focus:ring-accent-red/50 focus:border-accent-red/50 transition-all font-sans resize-none"
                required
                placeholder="Hola, me gustaría consultar por..."
                name="message"
              ></textarea>
            </div>
            
            <div class="mt-2">
              <Button 
                btnType="submit" 
                text="Enviar mensaje" 
                icon={`<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-send-horizontal"><path d="m3 3 3 9-3 9 19-9Z"/><path d="M6 12h16"/></svg>`}
              />
            </div>
          </form>
        </div>

        <!-- Redes -->
        <div class="w-full lg:w-5/12 glass-panel p-8 md:p-10 rounded-3xl flex flex-col gap-10 border border-glass-border">
          <div class="flex flex-col gap-6">
            <h2 class="text-2xl font-display font-medium text-text-primary">
              Nuestras redes
            </h2>
            <div class="flex flex-col gap-4">
              {
                socialMedia
                  .filter((social) => social.label !== "WhatsApp")
                  .map((social) => (
                    <SocialMediaLink
                      href={social.href}
                      icon={social.icon}
                      label={social.label}
                    />
                  ))
              }
            </div>
          </div>

          <div class="w-full h-[1px] bg-glass-border"></div>

          <div class="flex flex-col gap-6">
            <div class="flex flex-col gap-2">
              <h2 class="text-2xl font-display font-medium text-text-primary">
                Atención directa
              </h2>
              <p class="text-text-secondary font-sans text-sm">
                Comunícate directamente con nuestro equipo.
              </p>
            </div>
            <div class="flex flex-col gap-4">
              <SocialMediaLink
                href="https://wa.link/rxypzc"
                icon="/whatsapp-icon.png"
                label="WhatsApp"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Validación con JS -->
  <script is:inline>
    document.addEventListener('astro:page-load', () => {
      const form = document.getElementById("contact-form");
      const email = document.getElementById("email");
      const message = document.getElementById("message");
      const errorMsg = document.getElementById("error-msg");

      if (form) {
        form.addEventListener("submit", function (e) {
          if (!email.value.trim() || !message.value.trim()) {
            e.preventDefault();
            errorMsg.classList.remove("hidden");
          } else {
            errorMsg.classList.add("hidden");
          }
        });
      }
    });
  </script>
</Layout>
