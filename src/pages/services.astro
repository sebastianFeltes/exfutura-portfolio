---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import macImg from "../assets/mac.webp";
import Layout from "../layouts/Layout.astro";
import ServicesCard from "../components/ServicesCard.astro";

const services = await getCollection("services");
---

<Layout title="Servicios">
  <section id="servicios" class="relative min-h-screen pt-24 pb-12 overflow-hidden">
    <!-- Background Image with Dark Overlay -->
    <div class="absolute inset-0 z-0 fixed" transition:persist="services-bg">
      <div class="absolute inset-0 bg-[var(--overlay-color)] mix-blend-multiply z-10"></div>
      <div class="absolute inset-0 bg-gradient-to-b from-[var(--bg-primary)] via-transparent to-[var(--bg-primary)]/50 z-10"></div>
      <Image
        src={macImg}
        loading="eager"
        decoding="async"
        fetchpriority="high"
        alt="Mac computer background"
        class="w-full h-full object-cover object-center"
      />
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-6xl mx-auto px-6 flex flex-col gap-12">
      <!-- Header -->
      <div class="text-center pt-8 pb-4">
        <h1 class="text-4xl md:text-5xl font-display font-bold text-text-primary tracking-tight">Servicios</h1>
        <div class="w-12 h-[2px] bg-accent-red/60 mx-auto mt-4 mb-2"></div>
        <p class="text-xl md:text-2xl font-sans font-light text-text-secondary">
          Soluciones integrales en tecnología
        </p>
      </div>

      <div class="grid gap-8 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3">
        {
          services.map((service) => (
            <ServicesCard
              slug={service.slug}
              id={service.id}
              image={service.data.bgImage}
              title={service.data.title}
              description={service.data.description}
              technologies={service.data.technologies}
            />
          ))
        }
      </div>
    </div>
  </section>
</Layout>
